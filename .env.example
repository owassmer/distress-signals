# SEC EDGAR requires a user agent with a contact email, e.g. "distress-signals you@example.com"
SEC_USER_AGENT=
# Claude sign-in for runs, read before each run: the macOS keychain item whose password is the OAuth token
# (e.g. one an account-switch script updates), or else a fixed token from `claude setup-token`
CLAUDE_TOKEN_KEYCHAIN=
CLAUDE_CODE_OAUTH_TOKEN=
# optional: model for the researcher (default opus) and its reasoning effort (default xhigh)
AGENT_MODEL=
AGENT_EFFORT=
# optional: database path (default distress.db in the repository root)
DISTRESS_DB=
# HubSpot private app or service key, for hubspot-setup, push-hubspot and pull-outcomes. Scopes:
# crm.objects.companies.read/write, crm.objects.contacts.read/write, crm.objects.deals.read/write,
# crm.schemas.contacts.read/write, crm.schemas.deals.read/write
HUBSPOT_SERVICE_KEY=
# optional: raises Socrata rate limits
SOCRATA_APP_TOKEN=

# Series that need a key are in a run's catalog only when the key is set (docs/data-sources.md lists them).
# api.data.gov key (free, https://api.data.gov/signup/): Regulations.gov's dockets, documents and comments, and FCC filings
DATA_GOV_API_KEY=
# USPTO Open Data Portal key: PTAB proceedings and documents
USPTO_API_KEY=
# NRC ADAMS Public Search subscription key: the NRC's ADAMS library
NRC_ADAMS_API_KEY=
# GovCon API key: GAO bid protests
GOVCON_API_KEY=
# MSRB continuing-disclosure subscription delivery, unpacked XML and PDFs: EMMA continuing disclosures
EMMA_DISCLOSURE_DIR=
# CSV catalog of a CSA Data Distribution Services delivery, with its PDFs beside it: SEDAR+ filings
SEDAR_DDS_INDEX=
# 1 where the deployment has the Canadian Securities Exchange's permission for commercial reuse: its listed companies' SEDAR+ filings
CSE_SEDAR_LICENSED=

# optional: reads the RECAP archive of federal court dockets live through CourtListener
COURTLISTENER_TOKEN=
# optional: adds the text of attachments to USITC filings
EDIS_API_TOKEN=
# optional: for a council whose Legistar asks for a token (config/legistar.yaml), set LEGISTAR_TOKEN_<CLIENT>
