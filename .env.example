# SEC EDGAR requires a user agent with a contact email, e.g. "distress-signals you@example.com"
SEC_USER_AGENT=
# Claude sign-in for runs, read before each run: the macOS keychain item whose password is the OAuth token
# (e.g. one an account-switch script updates), or else a fixed token from `claude setup-token`
CLAUDE_TOKEN_KEYCHAIN=
CLAUDE_CODE_OAUTH_TOKEN=
# optional: model for the researcher (default opus) and its reasoning effort (default xhigh)
AGENT_MODEL=
AGENT_EFFORT=
# optional: database path (default distress.db in the repository root)
DISTRESS_DB=
# HubSpot private app or service key, for hubspot-setup, push-hubspot and pull-outcomes. Scopes:
# crm.objects.companies.read/write, crm.objects.contacts.read/write, crm.objects.deals.read/write,
# crm.schemas.contacts.read/write, crm.schemas.deals.read/write
HUBSPOT_SERVICE_KEY=
# optional: raises Socrata rate limits
SOCRATA_APP_TOKEN=

# Public-record credentials (required only for the specified sources)
# USPTO Open Data Portal key for PTAB proceedings and documents
USPTO_API_KEY=
# NRC ADAMS Public Search subscription key
NRC_ADAMS_API_KEY=
# EDIS account API token for downloading filing attachments
EDIS_API_TOKEN=
# Optional FCC data.gov key for a dedicated ECFS quota
FCC_API_KEY=
# For a Legistar jurisdiction that requires an access token, set LEGISTAR_TOKEN_<CLIENT>

# MSRB continuing-disclosure delivery, unpacked XML/PDF directory
EMMA_DISCLOSURE_DIR=
# Authorized SEDAR+ current-document CSV and original PDFs, described in docs/data-sources.md
SEDAR_DDS_INDEX=
# Set to 1 if the deployment is authorized to use the CSE's SEDAR filing copies commercially
CSE_SEDAR_LICENSED=
# SAM.gov notice search API (the public daily active opportunities file works without a key)
SAM_API_KEY=
# Optional data.gov key for Regulations.gov and GovInfo; per-source keys override it
DATA_GOV_API_KEY=
REGULATIONS_GOV_API_KEY=
GOVINFO_API_KEY=
# CourtListener API token for the live RECAP search and docket entries
COURTLISTENER_TOKEN=
# GovCon API key for protest discovery; individual GAO dockets are public by B-number
GOVCON_API_KEY=
